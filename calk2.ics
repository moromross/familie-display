<script>
    untis.messages = {};
    function define(nameOrMessages, messages) {
        if (typeof nameOrMessages === "object") {
            messages = nameOrMessages;
        }
        // Object.assign polyfill wird erst spï¿½ter geladen. Daher werden die Messages hier direkt eingemischt.
